CREATE TABLE collection_entry (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    category TEXT NOT NULL,
    status TEXT NOT NULL CHECK (status IN ('RESERVED', 'OWNED', 'PLANNED_CLEANUP')),
    series_name TEXT,
    character_name TEXT,
    quantity INTEGER NOT NULL DEFAULT 1 CHECK (quantity > 0),
    purchase_price INTEGER,
    purchase_date TEXT,
    purchase_store TEXT,
    storage_location_id TEXT,
    release_date TEXT,
    reservation_store TEXT,
    related_link TEXT,
    note TEXT,
    created_at TEXT NOT NULL,
    updated_at TEXT NOT NULL,
    currency_code TEXT NOT NULL DEFAULT 'KRW',
    canceled_at TEXT,
    has_reservation INTEGER NOT NULL DEFAULT 0,
    order_date TEXT,
    total_price INTEGER,
    deposit_price INTEGER,
    remaining_price INTEGER,
    shipping_fee INTEGER,
    reservation_number TEXT,
    received_at TEXT
);

CREATE INDEX collection_status_updated ON collection_entry(status, updated_at);

CREATE TABLE event (
    id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    event_type TEXT NOT NULL,
    target_date TEXT NOT NULL,
    related_entry_id TEXT REFERENCES collection_entry(id) ON DELETE SET NULL,
    location_or_store TEXT,
    memo TEXT,
    created_at TEXT NOT NULL,
    updated_at TEXT NOT NULL
);

CREATE INDEX event_date ON event(target_date);
CREATE INDEX event_entry ON event(related_entry_id);

CREATE TABLE app_preference (
    id INTEGER NOT NULL PRIMARY KEY CHECK (id = 1),
    currency_code TEXT NOT NULL,
    date_format TEXT NOT NULL,
    language_code TEXT NOT NULL
);

selectEntries:
SELECT * FROM collection_entry WHERE canceled_at IS NULL ORDER BY updated_at DESC, id;

selectAllEntries:
SELECT * FROM collection_entry ORDER BY updated_at DESC, id;

selectEntry:
SELECT * FROM collection_entry WHERE id = ?;

upsertEntry:
INSERT INTO collection_entry VALUES ?;

updateEntry:
UPDATE collection_entry SET
    name = :name, category = :category, status = :status,
    series_name = :series_name, character_name = :character_name,
    quantity = :quantity, purchase_price = :purchase_price,
    purchase_date = :purchase_date, purchase_store = :purchase_store,
    storage_location_id = :storage_location_id, release_date = :release_date,
    reservation_store = :reservation_store, related_link = :related_link,
    note = :note, updated_at = :updated_at, currency_code = :currency_code,
    canceled_at = :canceled_at, has_reservation = :has_reservation,
    order_date = :order_date, total_price = :total_price,
    deposit_price = :deposit_price, remaining_price = :remaining_price,
    shipping_fee = :shipping_fee, reservation_number = :reservation_number,
    received_at = :received_at WHERE id = :id;

receiveEntry:
UPDATE collection_entry SET status = 'OWNED', received_at = :receivedAt, updated_at = :receivedAt,
    has_reservation = 1, purchase_date = coalesce(purchase_date, :receivedDate)
WHERE id = :id AND status = 'RESERVED' AND canceled_at IS NULL;

cancelEntry:
UPDATE collection_entry SET canceled_at = :canceledAt, updated_at = :canceledAt
WHERE id = :id AND status = 'RESERVED' AND canceled_at IS NULL;

deleteEntry:
DELETE FROM collection_entry WHERE id = ?;

clearEventLinks:
UPDATE event SET related_entry_id = NULL WHERE related_entry_id = ?;

selectEvents:
SELECT * FROM event ORDER BY target_date, id;

upsertEvent:
INSERT INTO event VALUES ?;

selectEvent:
SELECT * FROM event WHERE id = ?;

updateEvent:
UPDATE event SET title = :title, event_type = :event_type, target_date = :target_date,
    related_entry_id = :related_entry_id, location_or_store = :location_or_store,
    memo = :memo, updated_at = :updated_at WHERE id = :id;

deleteEvent:
DELETE FROM event WHERE id = ?;

selectPreferences:
SELECT * FROM app_preference WHERE id = 1;

upsertPreferences:
INSERT OR REPLACE INTO app_preference VALUES (1, ?, ?, ?);
